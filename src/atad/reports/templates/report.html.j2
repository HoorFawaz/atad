{#- Copyright (C) 2026 Hoor Fawaz
    SPDX-License-Identifier: LicenseRef-ATAD-SAL-1.0
    ATAD investigation report. One self-contained file: no external fonts, scripts or images.
    Structure follows common forensic report practice (SWGDE 18-Q-002): identification,
    scope, results with their basis, items examined with hashes, limitations. -#}
{%- set s = r.summary -%}
{%- set tlp = r.report.classification -%}
{%- set tlp_class = tlp | lower | replace('tlp:', '') | replace('+strict', '') -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="{{ r.report.generator }}">
<title>{{ r.report.id }} — Investigation Report — {{ r.case.name }}</title>
<style>
:root {
  --ink: #16202a; --muted: #5a6672; --faint: #8a949e; --line: #d4d9de; --line-strong: #9aa4ad;
  --head: #1f3550; --head-bg: #eef1f4; --zebra: #f8f9fa; --page: #ffffff; --desk: #e9ecef;
  --critical: #7a1020; --high: #b42318; --medium: #b54708; --low: #175cd3; --info: #4b5563;
  --ok: #067647; --bad: #b42318;
  --sans: "Segoe UI", "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  --mono: Consolas, "Cascadia Mono", "SFMono-Regular", Menlo, "Liberation Mono", monospace;
}
* { box-sizing: border-box; }
html { background: var(--desk); }
body { margin: 0; background: var(--desk); color: var(--ink); font: 13.5px/1.5 var(--sans);
       font-variant-numeric: tabular-nums; }
a { color: var(--head); }
.mono, code { font-family: var(--mono); font-size: 12px; }
.doc { max-width: 980px; margin: 24px auto; background: var(--page); border: 1px solid var(--line);
       padding: 0 48px 32px; }

/* classification bar (TLP 2.0 colours: label text on black) */
.tlpbar { display: flex; justify-content: space-between; align-items: center; gap: 12px;
          border-bottom: 1px solid var(--line); padding: 10px 0; font-size: 11.5px; color: var(--muted); }
.tlpbar.bottom { border-bottom: 0; border-top: 1px solid var(--line); margin-top: 28px; }
.tlp { background: #000; font: 700 12px/1 var(--sans); letter-spacing: .04em; padding: 5px 8px; white-space: nowrap; }
.tlp.red { color: #ff2b2b; } .tlp.amber { color: #ffc000; } .tlp.green { color: #33ff00; } .tlp.clear { color: #fff; }

header.title { padding: 28px 0 8px; }
.kicker { font: 600 11.5px var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin: 0 0 6px; }
h1 { font: 600 24px/1.25 var(--sans); margin: 0 0 6px; color: var(--head); overflow-wrap: anywhere; }
.subtitle { color: var(--muted); margin: 0 0 18px; max-width: 760px; }

.notice { overflow-wrap: anywhere; border: 1px solid var(--bad); border-left-width: 4px; padding: 8px 12px; margin: 0 0 18px; }
.notice strong { color: var(--bad); }

table { width: 100%; border-collapse: collapse; margin: 6px 0 14px; font-size: 12.5px; }
th, td { border: 1px solid var(--line); padding: 5px 8px; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
thead th { background: var(--head-bg); color: var(--head); font-weight: 600; font-size: 11.5px; }
tbody tr:nth-child(even) td { background: var(--zebra); }
table.kv th { width: 190px; background: var(--head-bg); color: var(--head); font-weight: 600; }
td.t, th.t, td.h { white-space: nowrap; }
td.t { font-family: var(--mono); font-size: 11.5px; }
td.n, th.n { text-align: right; width: 1%; white-space: nowrap; }
.scroll { overflow-x: auto; }
.scroll > table { min-width: 640px; }

h2 { font: 600 16px/1.3 var(--sans); color: var(--head); margin: 30px 0 8px; padding-bottom: 5px;
     border-bottom: 2px solid var(--head); }
h3 { font: 600 14px/1.35 var(--sans); color: var(--ink); margin: 22px 0 6px; overflow-wrap: anywhere; }
h3 .ref { font-family: var(--mono); font-size: 12.5px; color: var(--head); margin-right: 8px; }
h4 { font: 600 12px var(--sans); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 10px 0 4px; }
p { margin: 0 0 8px; overflow-wrap: anywhere; }
.muted { color: var(--muted); }
.note { color: var(--muted); font-size: 12px; }

.sev { white-space: nowrap; font-weight: 600; }
.sev::before { content: ""; display: inline-block; width: 8px; height: 8px; margin-right: 6px; vertical-align: 0; background: var(--c); }
.sev-critical { --c: var(--critical); color: var(--critical); } .sev-high { --c: var(--high); color: var(--high); }
.sev-medium { --c: var(--medium); color: var(--medium); } .sev-low { --c: var(--low); color: var(--low); }
.sev-info { --c: var(--info); color: var(--info); }
.ok { color: var(--ok); font-weight: 600; } .bad { color: var(--bad); font-weight: 600; }

.finding { border-top: 1px solid var(--line); padding-top: 2px; margin-top: 18px; break-inside: avoid-page; }
.basis { overflow-wrap: anywhere; border-left: 3px solid var(--head); background: var(--head-bg); padding: 8px 12px; margin: 4px 0 10px; }
tr.mark td { background: #fdf3f2 !important; font-weight: 600; }
tr:target td { outline: 2px solid var(--head); outline-offset: -2px; }
details summary { cursor: pointer; color: var(--head); font-size: 12px; }
pre { white-space: pre-wrap; overflow-wrap: anywhere; font: 11.5px/1.45 var(--mono); background: var(--zebra);
      border: 1px solid var(--line); padding: 6px 8px; margin: 4px 0; }
ul { margin: 0 0 8px; padding-left: 20px; }
.toc { columns: 2; column-gap: 32px; padding-left: 18px; margin: 0; }
.toc li { margin: 1px 0; }
.sign { margin-top: 26px; }
.sign td { height: 40px; }

@media (max-width: 720px) {
  .doc { margin: 0; border: 0; padding: 0 16px 24px; }
  .toc { columns: 1; }
  table.kv th { width: 120px; }
}
@media print {
  @page { size: A4; margin: 16mm 14mm; }
  html, body { background: #fff; }
  .doc { margin: 0; border: 0; padding: 0; max-width: none; }
  h2 { break-after: avoid-page; }
  a { color: inherit; text-decoration: none; }
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
}
</style>
</head>
<body>
<div class="doc">

<div class="tlpbar"><span>{{ r.report.id }} · {{ r.case.id }}</span><span class="tlp {{ tlp_class }}">{{ tlp }}</span></div>

<header class="title">
  <p class="kicker">Investigation report</p>
  <h1>{{ r.case.name }}</h1>
  {%- if r.case.description %}<p class="subtitle">{{ r.case.description }}</p>{% endif %}

  {%- if r.case.simulated or s.evidence_simulated %}
  <div class="notice"><strong>Simulated data.</strong> This report is built from simulated evidence for demonstration and testing. It does not describe a real incident.</div>
  {%- endif %}
  {%- for p in problems %}
  <div class="notice"><strong>Attention.</strong> {{ p }}</div>
  {%- endfor %}

  <table class="kv">
    <tr><th>Report ID</th><td class="mono">{{ r.report.id }}</td></tr>
    <tr><th>Case</th><td><span class="mono">{{ r.case.id }}</span> — {{ r.case.name }}</td></tr>
    <tr><th>Case profile</th><td>{{ r.case.profile | upper }}</td></tr>
    <tr><th>Case opened</th><td>{{ r.case.created_at | t }} UTC</td></tr>
    <tr><th>Report date</th><td>{{ r.report.generated_at | t }} UTC</td></tr>
    <tr><th>Systems examined</th><td>{{ s.hosts | join(', ') if s.hosts else '—' }}</td></tr>
    <tr><th>Period of events</th><td>{% if s.first_event %}{{ s.first_event | t }} – {{ s.last_event | t }} UTC{% else %}—{% endif %}</td></tr>
    <tr><th>Classification</th><td><span class="tlp {{ tlp_class }}">{{ tlp }}</span></td></tr>
    <tr><th>Data</th><td>{{ 'SIMULATED' if r.case.simulated else 'Collected evidence' }}</td></tr>
    <tr><th>Prepared with</th><td>{{ r.report.generator }} (report format {{ r.report.format }} v{{ r.report.version }})</td></tr>
  </table>

  <h4>Contents</h4>
  <ol class="toc">
    <li><a href="#s1">Executive summary</a></li>
    <li><a href="#s2">Scope and method</a></li>
    <li><a href="#s3">Findings</a></li>
    <li><a href="#s4">Timeline of events</a></li>
    <li><a href="#s5">Indicators and authorized scope</a></li>
    <li><a href="#s6">Evidence integrity</a></li>
    <li><a href="#s7">Coverage and limitations</a></li>
    <li><a href="#appA">Appendix A — Evidence register</a></li>
    <li><a href="#appB">Appendix B — Rules and terms</a></li>
  </ol>
</header>

<section id="s1">
  <h2>1. Executive summary</h2>
  {%- for para in summary_text %}<p>{{ para }}</p>{% endfor %}
  <table>
    <thead><tr>{% for sev in severities %}<th class="n">{{ sev | capitalize }}</th>{% endfor %}<th class="n">Total</th></tr></thead>
    <tbody><tr>{% for sev in severities %}<td class="n">{{ s.findings_by_severity[sev] }}</td>{% endfor %}<td class="n"><strong>{{ s.findings_total }}</strong></td></tr></tbody>
  </table>
  {%- set key = r.findings | rejectattr('category', 'equalto', 'correlated') | list %}
  {%- if key %}
  <h4>Key findings</h4>
  <div class="scroll"><table>
    <thead><tr><th>ID</th><th>Severity</th><th>Finding</th><th>System</th><th class="t">First seen (UTC)</th></tr></thead>
    <tbody>
    {%- for f in key[:10] %}
      <tr><td class="t"><a href="#{{ f.id }}">{{ f.id }}</a></td><td><span class="sev sev-{{ f.severity }}">{{ f.severity | capitalize }}</span></td>
          <td>{{ f.title }}</td><td class="h">{{ f.hosts | join(', ') }}</td><td class="t">{{ (f.first_seen | t) if f.first_seen else '—' }}</td></tr>
    {%- endfor %}
    </tbody>
  </table></div>
  {%- if key | length > 10 %}<p class="note">{{ key | length - 10 }} further finding(s) in Section 3.</p>{% endif %}
  {%- endif %}
</section>

<section id="s2">
  <h2>2. Scope and method</h2>
  <p>Evidence was collected and normalized by ATAD. Each tool run is recorded with its exact command,
     version, status and a SHA-256 hash of its raw output (Sections 6 and 7). Findings are produced by the
     documented correlation rules in Appendix B; each states its basis and the evidence it rests on.
     All times are in UTC.</p>
  <div class="scroll"><table>
    <thead><tr><th>Source module</th><th class="n">Evidence records</th></tr></thead>
    <tbody>
    {%- for mod, n in s.evidence_by_module | dictsort %}<tr><td>{{ mod }}</td><td class="n">{{ n }}</td></tr>{% endfor %}
    <tr><td><strong>Total</strong></td><td class="n"><strong>{{ s.evidence_total }}</strong></td></tr>
    </tbody>
  </table></div>
  <p class="note"><strong>Severity</strong> is how serious a finding would be if confirmed. <strong>Confidence</strong> is how strongly the evidence supports it.</p>
</section>

<section id="s3">
  <h2>3. Findings</h2>
  {%- for f in r.findings %}
  <div class="finding" id="{{ f.id }}">
    <h3><span class="ref">3.{{ loop.index }} · {{ f.id }}</span>{{ f.title }}</h3>
    <table class="kv">
      <tr><th>Severity</th><td><span class="sev sev-{{ f.severity }}">{{ f.severity | capitalize }}</span></td></tr>
      <tr><th>Confidence</th><td>{{ f.confidence | capitalize }}</td></tr>
      <tr><th>Category</th><td>{{ f.category | capitalize }}</td></tr>
      <tr><th>Rule</th><td>{{ f.rule_id or '—' }}{% if f.rule_id in rules %} — {{ rules[f.rule_id] }}{% endif %}</td></tr>
      <tr><th>System(s)</th><td>{{ f.hosts | join(', ') or '—' }}</td></tr>
      <tr><th>Period (UTC)</th><td>{% if f.first_seen %}{{ f.first_seen | t }}{% if f.last_seen != f.first_seen %} – {{ f.last_seen | t }}{% endif %}{% else %}—{% endif %}</td></tr>
      {%- if f.description %}<tr><th>Indicator note</th><td>{{ f.description }}</td></tr>{% endif %}
    </table>
    <h4>Basis</h4>
    <div class="basis">{{ f.rationale }}</div>
    <h4>Supporting evidence ({{ f.evidence_ids | length }})</h4>
    <div class="scroll"><table>
      <thead><tr><th>Evidence</th><th class="t">Time (UTC)</th><th>System</th><th>Source</th><th>Record</th></tr></thead>
      <tbody>
      {%- for eid in f.evidence_ids %}{% set e = ev_by_id.get(eid) %}
        <tr><td class="t"><a href="#{{ eid }}">{{ eid }}</a></td><td class="t">{{ (e.event_time | t) if e and e.event_time else '—' }}</td>
            <td class="h">{{ e.host if e else '' }}</td><td>{{ e.source_module ~ ' / ' ~ e.source_tool if e else '' }}</td><td>{{ e.summary if e else 'missing' }}</td></tr>
      {%- endfor %}
      </tbody>
    </table></div>
  </div>
  {%- else %}
  <p>No findings. Either no rule matched the evidence, or correlation (<code>atad correlate</code>) has not been run for this case.</p>
  {%- endfor %}
</section>

<section id="s4">
  <h2>4. Timeline of events</h2>
  <p>Every evidence record with an event time, in order. Rows in bold mark a finding at the time of its earliest evidence.
    {%- if r.timeline | length > limits.timeline %} The first {{ limits.timeline }} of {{ r.timeline | length }} entries are shown; the complete timeline is in the JSON report and <code>atad export timeline</code>.{% endif %}</p>
  {%- if r.timeline %}
  <div class="scroll"><table>
    <thead><tr><th class="t">Time (UTC)</th><th>System</th><th>Ref.</th><th>Event</th></tr></thead>
    <tbody>
    {%- for t in r.timeline[:limits.timeline] %}
      <tr{% if t.finding_id %} class="mark"{% endif %}><td class="t">{{ t.time | t }}</td><td class="h">{{ t.host }}</td>
        <td class="t"><a href="#{{ t.finding_id or t.evidence_id }}">{{ t.finding_id or t.evidence_id }}</a></td><td>{{ t.description }}</td></tr>
    {%- endfor %}
    </tbody>
  </table></div>
  {%- else %}<p>No evidence with an event time.</p>{% endif %}
</section>

<section id="s5">
  <h2>5. Indicators and authorized scope</h2>
  <h4>Indicators of compromise loaded</h4>
  {%- if r.iocs %}
  <div class="scroll"><table>
    <thead><tr><th>Type</th><th>Value</th><th>Confidence</th><th>List</th><th>Note</th></tr></thead>
    <tbody>
    {%- for i in r.iocs[:limits.iocs] %}<tr><td>{{ i.type }}</td><td class="mono">{{ i.value }}</td><td>{{ i.confidence | capitalize }}</td><td>{{ i.source }}</td><td>{{ i.description }}</td></tr>{% endfor %}
    </tbody>
  </table></div>
  {%- if r.iocs | length > limits.iocs %}<p class="note">{{ r.iocs | length - limits.iocs }} more in the JSON report.</p>{% endif %}
  {%- else %}<p>No indicator lists were loaded.</p>{% endif %}
  <h4>Authorized network scope</h4>
  {%- if r.scope %}
  <div class="scroll"><table>
    <thead><tr><th>Target</th><th>Kind</th><th>Public</th><th class="t">Added (UTC)</th><th>Note</th></tr></thead>
    <tbody>
    {%- for t in r.scope %}<tr><td class="mono">{{ t.value }}</td><td>{{ t.kind }}</td><td>{{ 'Yes' if t.public else 'No' }}</td><td class="t">{{ t.added_at | t }}</td><td>{{ t.note }}</td></tr>{% endfor %}
    </tbody>
  </table></div>
  {%- else %}<p>No network targets were authorized in this case.</p>{% endif %}
</section>

<section id="s6">
  <h2>6. Evidence integrity</h2>
  <p>Every raw file was hashed with SHA-256 when it was collected and stored read-only in the case folder.
     The files were hashed again when this report was produced.</p>
  {%- if r.integrity %}
  <div class="scroll"><table>
    <thead><tr><th>Raw file</th><th>SHA-256 recorded at collection</th><th>Result</th></tr></thead>
    <tbody>
    {%- for i in r.integrity %}
      <tr><td class="mono">{{ i.raw_ref }}</td><td class="mono">{{ i.expected_sha256 }}</td>
          <td class="{{ 'ok' if i.status == 'verified' else 'bad' }}">{{ i.status | capitalize }}{% if i.status == 'changed' %}<br><span class="mono">now {{ i.actual_sha256 }}</span>{% endif %}</td></tr>
    {%- endfor %}
    </tbody>
  </table></div>
  {%- else %}<p>No raw files are recorded for this case.</p>{% endif %}
</section>

<section id="s7">
  <h2>7. Coverage and limitations</h2>
  <p>Every check that was requested, including those that did not run. A check that did not run cannot
     produce a finding; the absence of findings from it is not evidence that nothing happened.</p>
  {%- if r.coverage %}
  <div class="scroll"><table>
    <thead><tr><th class="n">#</th><th>Module</th><th>Tool (version)</th><th>Input / target</th><th class="t">Started (UTC)</th><th>Result</th><th>Admin</th><th>Note</th></tr></thead>
    <tbody>
    {%- for c in r.coverage %}
      <tr><td class="n">{{ c.id }}</td><td>{{ c.module }}</td><td>{{ c.tool }}{% if c.tool_version %} ({{ c.tool_version }}){% endif %}</td>
          <td>{{ c.target or ((c.command | last) if c.command else '') }}</td><td class="t">{{ c.started_at | t }}</td>
          <td class="{{ 'ok' if c.status == 'success' else ('muted' if c.status == 'skipped' else 'bad') }}">{{ c.label | capitalize }}</td>
          <td>{{ 'Yes' if c.elevated else ('No' if c.elevated is not none else '—') }}</td><td>{{ c.error or '' }}</td></tr>
    {%- endfor %}
    </tbody>
  </table></div>
  {%- else %}<p>No collection was run in this case.</p>{% endif %}
  <h4>Limitations</h4>
  <ul>
    <li>Findings come from documented rules and indicator lists. Activity that matches no rule is not reported as a finding, but its evidence remains in Appendix A.</li>
    <li>Shared IP addresses, domains and paths can link unrelated activity (NAT, DHCP, common programs); the confidence of each finding reflects this.</li>
    <li>Times are as recorded by each source and converted to UTC; clock differences between systems are not corrected.</li>
    {%- if r.case.simulated %}<li>All evidence in this case is simulated.</li>{% endif %}
  </ul>
</section>

<section id="appA">
  <h2>Appendix A — Evidence register</h2>
  <p>Normalized evidence records. Each refers to the raw file it was read from (Section 6). Systems marked * were named by the analyst for imported evidence.
    {%- if r.evidence | length > limits.evidence %} The first {{ limits.evidence }} of {{ r.evidence | length }} records are shown; all are in the JSON report.{% endif %}</p>
  {%- if r.evidence %}
  <div class="scroll"><table>
    <thead><tr><th>ID</th><th class="t">Time (UTC)</th><th>System</th><th>Source</th><th>Record</th></tr></thead>
    <tbody>
    {%- for e in r.evidence[:limits.evidence] %}
      <tr id="{{ e.id }}"><td class="t">{{ e.id }}</td><td class="t">{{ (e.event_time | t) if e.event_time else '—' }}</td>
        <td class="h">{{ e.host }}{% if e.host_declared %}*{% endif %}</td>
        <td>{{ e.source_module }} / {{ e.source_tool }}<br><span class="note">{{ e.collection_mode }}</span></td>
        <td>{{ e.summary }}
          <details><summary>Details</summary>
            {%- if e.observables %}<p class="note">Observables: {% for o in e.observables %}<code>{{ o.type }}={{ o.value }}</code>{{ '; ' if not loop.last }}{% endfor %}</p>{% endif %}
            <p class="note">Raw: <code>{{ e.raw_ref or '—' }}</code>{% if e.raw_sha256 %} · SHA-256 <code>{{ e.raw_sha256 }}</code>{% endif %} · collected {{ e.collected_at | t }} UTC</p>
            <pre>{{ e.data | tojson(indent=2) }}</pre>
          </details></td></tr>
    {%- endfor %}
    </tbody>
  </table></div>
  {%- else %}<p>No evidence was collected.</p>{% endif %}
</section>

<section id="appB">
  <h2>Appendix B — Rules and terms</h2>
  <div class="scroll"><table>
    <thead><tr><th>Rule</th><th>Meaning</th><th class="n">Findings</th></tr></thead>
    <tbody>
    {%- for rid, desc in rules.items() %}<tr><td class="t">{{ rid }}</td><td>{{ desc }}</td><td class="n">{{ s.findings_by_rule.get(rid, 0) }}</td></tr>{% endfor %}
    </tbody>
  </table></div>
  <table class="kv">
    <tr><th>Suspicious</th><td>Evidence that matches a known pattern of attack.</td></tr>
    <tr><th>Correlated</th><td>Records from different events or sources linked by a shared indicator.</td></tr>
    <tr><th>Hypothesis</th><td>A possible explanation that needs further investigation.</td></tr>
    <tr><th>{{ tlp }}</th><td>Traffic Light Protocol 2.0 (FIRST): limits on who may receive this report.</td></tr>
  </table>

  <table class="sign">
    <thead><tr><th>Reviewed by (name)</th><th>Signature</th><th>Date</th></tr></thead>
    <tbody><tr><td></td><td></td><td></td></tr></tbody>
  </table>
</section>

<div class="tlpbar bottom"><span>{{ r.report.id }} · {{ r.report.generator }} · ATAD (عَتاد) by Hoor Fawaz · ATAD Source-Available License 1.0</span><span class="tlp {{ tlp_class }}">{{ tlp }}</span></div>
</div>
</body>
</html>
